<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- 仅演示嵌入普通 web 应用，不参与 AOT 分析 -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZlmSharp\ZlmSharp.csproj" />
  </ItemGroup>

  <!-- 管理页面（单文件 html）：库项目的 Content 不会传递到引用方，这里显式带上 WebUI/ -->
  <ItemGroup>
    <Content Include="..\..\src\ZlmSharp\WebUI\index.html" Link="WebUI\index.html"
             Condition="Exists('..\..\src\ZlmSharp\WebUI\index.html')"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\ZlmSharp\WebUI\index.html.br" Link="WebUI\index.html.br"
             Condition="Exists('..\..\src\ZlmSharp\WebUI\index.html.br')"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\ZlmSharp\WebUI\index.html.gz" Link="WebUI\index.html.gz"
             Condition="Exists('..\..\src\ZlmSharp\WebUI\index.html.gz')"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
