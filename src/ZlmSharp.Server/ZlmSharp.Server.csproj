<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ZlmSharp.Server</RootNamespace>
    <AssemblyName>ZlmSharp.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZlmSharp.Api\ZlmSharp.Api.csproj" />
    <ProjectReference Include="..\ZlmSharp.Configuration\ZlmSharp.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))" />
    <AssemblyMetadata Include="BranchName" Value="main" />
    <AssemblyMetadata Include="CommitHash" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
    <AssemblyMetadata Include="CommitHash" Value="unknown" Condition="'$(SourceRevisionId)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
  </ItemGroup>

</Project>
