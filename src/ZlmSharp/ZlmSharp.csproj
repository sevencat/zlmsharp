<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ZlmSharp</RootNamespace>
    <!-- CLI 的 exe 名固定为 zlmsharp，程序集名不能与之大小写不敏感重名，故加 MediaServer 后缀 -->
    <AssemblyName>ZlmSharp.MediaServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 推理引擎不在此引用：核心库只定义 IYoloBackendFactory，具体适配器作为独立项目接入 -->
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZlmSharp.Tests" />
  </ItemGroup>

  <!--
    内置管理页面（单文件 html）：不再内嵌进程序集，构建/发布时拷到输出目录 WebUI/，
    运行期由 AdminPageEndpoints 从磁盘读取（http.rootPath 默认 ./WebUI，可覆盖以便热替换）。
    产物由 web/ 工程生成：`npm run build` 会把 dist/index.html 写回这里，并预生成 .br/.gz。
  -->
  <ItemGroup>
    <None Remove="WebUI\index.html" />
    <Content Include="WebUI\index.html" Link="WebUI\index.html"
             Condition="Exists('WebUI\index.html')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <None Remove="WebUI\index.html.br" Condition="Exists('WebUI\index.html.br')" />
    <Content Include="WebUI\index.html.br" Link="WebUI\index.html.br"
             Condition="Exists('WebUI\index.html.br')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <None Remove="WebUI\index.html.gz" Condition="Exists('WebUI\index.html.gz')" />
    <Content Include="WebUI\index.html.gz" Link="WebUI\index.html.gz"
             Condition="Exists('WebUI\index.html.gz')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))" />
    <AssemblyMetadata Include="BranchName" Value="main" />
    <AssemblyMetadata Include="CommitHash" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
    <AssemblyMetadata Include="CommitHash" Value="unknown" Condition="'$(SourceRevisionId)' == ''" />
  </ItemGroup>

</Project>
