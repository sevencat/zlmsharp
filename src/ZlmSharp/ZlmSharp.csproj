<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ZlmSharp</RootNamespace>
    <!-- CLI 的 exe 名固定为 zlmsharp，程序集名不能与之大小写不敏感重名，故加 MediaServer 后缀 -->
    <AssemblyName>ZlmSharp.MediaServer</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Sevencat.ZlmSharp.MediaServer</PackageId>
    <Authors>sevencat</Authors>
    <PackageIcon>app-icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 推理引擎不在此引用：核心库只定义 IYoloBackendFactory，具体适配器作为独立项目接入 -->
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZlmSharp.Tests" />
  </ItemGroup>

  <!--
    内置管理页面（单文件 html）：只保留 gzip 预压缩版本并内嵌进程序集，
    发布产物里不再有 WebUI 目录，部署只需要 exe + zlmsharp.ini。
    运行期由 AdminPageEndpoints 从嵌入资源读取，客户端支持 gzip 就发压缩体，否则回退明文。
    产物由 web/ 工程生成：`npm run build` 会把 index.html.gz 写回这里。
  -->
  <ItemGroup>
    <None Remove="WebUI\index.html.gz" Condition="Exists('WebUI\index.html.gz')" />
    <EmbeddedResource Include="WebUI\index.html.gz"
                      Condition="Exists('WebUI\index.html.gz')"
                      LogicalName="ZlmSharp.WebUI.index.html.gz" />
    <None Update="app-icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))" />
    <AssemblyMetadata Include="BranchName" Value="main" />
    <AssemblyMetadata Include="CommitHash" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
    <AssemblyMetadata Include="CommitHash" Value="unknown" Condition="'$(SourceRevisionId)' == ''" />
  </ItemGroup>

</Project>
