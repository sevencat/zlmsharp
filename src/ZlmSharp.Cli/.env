ZLM_FFMPEG_BIN=E:\program\ffmpeg\81\ffmpeg.exe

# ===== YOLO：暂时禁用 =====
# 清空 ZLM_YOLO_MODEL 即关闭 YOLO（模型目录保留，恢复时只填模型名即可）
ZLM_YOLO_MODEL_DIR=F:\ai\models\yolo
ZLM_YOLO_MODEL=

# ===== OCR：启用（内置 PP-OCRv6 tiny 模型，无需额外下载）=====
ZLM_OCR_ENABLE=1
# 内置模型名：tiny
ZLM_OCR_MODEL=tiny
# 自定义模型（可选）：DET/REC/DICT 三者齐全时优先于内置模型
ZLM_OCR_DET_MODEL=
ZLM_OCR_REC_MODEL=
ZLM_OCR_CLS_MODEL=
ZLM_OCR_DICT=
# 识别分数下限（0~1）/ 方向分类 / 行并行线程数
ZLM_OCR_MIN_SCORE=0.3
ZLM_OCR_USE_CLS=1
ZLM_OCR_LINE_WORKERS=1
# 同一路流两次 OCR 的最小间隔（毫秒）：OCR 是 CPU 密集任务，不宜过小
ZLM_OCR_SAMPLE_INTERVAL_MS=2000

# ===== 叠加策略 =====
# reuse = 每帧都用最近一次结果绘制（不跳帧）；skip = 只叠加新鲜结果
ZLM_OVERLAY_FRAME_POLICY=reuse
ZLM_OVERLAY_RESULT_MAX_AGE_MS=0
# OCR 忙时跳过本轮，避免排队积压
ZLM_ANALYSIS_BUSY_POLICY=skip
