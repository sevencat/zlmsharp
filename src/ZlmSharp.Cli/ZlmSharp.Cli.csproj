<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZlmSharp.Cli</RootNamespace>
    <AssemblyName>zlmsharp</AssemblyName>

    <!-- Win32 图标（assets/app.ico 由 tools/make-icon.ps1 生成），JIT 与 NativeAOT 都会写入 exe -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>

    <!-- 发布即 NativeAOT；dotnet run 仍走 JIT 便于调试 -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>

    <!-- 发布目录只留 exe + zlmsharp.ini -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!-- SimdYolo 未声明 AOT/裁剪兼容（见下方 TrimmerRootAssembly 注释）。
         IL2104/IL3053 是「该程序集有 N 条告警」的汇总码，仅这两条放行，其他 AOT 告警仍按错误处理。 -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZlmSharp\ZlmSharp.csproj" />
  </ItemGroup>

  <!-- 内置管理页面（单文件 html，由 web/ 工程构建）：库项目的 Content 不会传递到引用方，
       所以在这里显式拷贝，产物目录/发布目录下会多一个 WebUI/（对应 http.rootPath 默认值）。 -->
  <ItemGroup>
    <Content Include="..\ZlmSharp\WebUI\index.html" Link="WebUI\index.html"
             Condition="Exists('..\ZlmSharp\WebUI\index.html')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ZlmSharp\WebUI\index.html.br" Link="WebUI\index.html.br"
             Condition="Exists('..\ZlmSharp\WebUI\index.html.br')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ZlmSharp\WebUI\index.html.gz" Link="WebUI\index.html.gz"
             Condition="Exists('..\ZlmSharp\WebUI\index.html.gz')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NLog 大量使用反射（布局渲染器/目标工厂），NativeAOT 下整体保留，避免运行期丢失类型 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="NLog" />
    <TrimmerRootAssembly Include="NLog.Extensions.Logging" />
  </ItemGroup>

  <!-- SimdYolo（本地 .nupkg，纯托管推理）未声明 AOT/裁剪兼容：整体保留其成员，
       否则 ILC 会因该程序集产生 IL2104/IL3053，被 TreatWarningsAsErrors 升级为错误。
       IL2104/IL3053 是「该程序集有 N 条告警」的汇总码，保留成员后仍需按码放行。 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="SimdYolo" />
  </ItemGroup>

  <!-- 发布目录保持干净：只留 zlmsharp.exe（首次运行自动生成 zlmsharp.ini）。
       ILC 会产出原生 pdb，ANCM shim 仅 IIS 在进程内托管时才需要，本项目自托管用不到。 -->
  <Target Name="CleanPublishOutput" AfterTargets="Publish">
    <PropertyGroup>
      <FullPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</FullPublishDir>
    </PropertyGroup>
    <ItemGroup>
      <PublishedJunk Include="$(FullPublishDir)*.pdb" />
      <PublishedJunk Include="$(FullPublishDir)aspnetcorev2_inprocess.dll" />
    </ItemGroup>
    <Delete Files="@(PublishedJunk)" />
  </Target>

</Project>
